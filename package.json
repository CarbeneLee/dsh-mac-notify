  "description": "Native macOS notifications for DeepSeek Harness: task completion, failures, approval requests and user questions.",
  "type": "module",
  "license": "MIT",
  "author": "CarbeneLee",
  "exports": {
    ".": "./dsh/index.js",
    "./notify": "./dsh/notify.js",
    "./config": "./dsh/config.js",
    "./text": "./dsh/text.js",
    "./package.json": "./package.json"
  },
  "files": [
